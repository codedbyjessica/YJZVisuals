---
import Icon from './Icon.astro';

const links = [
  ['#portfolio', 'Portfolio'],
  ['#research', 'Research'],
  ['#skills', 'Skills'],
  ['#about', 'About'],
  ['#contact', 'Contact'],
];
---

<nav class="nav at-top">
  <a class="brand" href="#top">YJZ</a>
  <button class="toggle" aria-expanded="false" aria-controls="menu" aria-label="Menu">
    <Icon name="bars" />
  </button>
  <ul id="menu">
    {links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
  </ul>
</nav>

<script>
  const nav = document.querySelector('nav.nav')!;
  const toggle = nav.querySelector('.toggle')!;
  const links = [...nav.querySelectorAll<HTMLAnchorElement>('#menu a')];

  // Transparent at the very top of the page, solid once scrolled.
  const onScroll = () => nav.classList.toggle('at-top', scrollY < 45);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Highlight the link of the section currently in view.
  const sectionObserver = new IntersectionObserver(
    (entries) => {
      for (const { target, isIntersecting } of entries) {
        if (isIntersecting) for (const a of links) a.classList.toggle('current', a.hash === `#${target.id}`);
      }
    },
    { rootMargin: '-40% 0px -55% 0px' },
  );
  document.querySelectorAll('main > section').forEach((s) => sectionObserver.observe(s));

  // Mobile menu
  const setOpen = (open: boolean) => {
    nav.classList.toggle('open', open);
    toggle.setAttribute('aria-expanded', String(open));
  };
  toggle.addEventListener('click', () => setOpen(!nav.classList.contains('open')));
  links.forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 45px;
    padding-inline: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    background: rgb(255 255 255 / 0.9);
    border-bottom: 1px solid var(--grey);
    transition: background-color 500ms, border-color 500ms;
  }
  .nav.at-top:not(.open) {
    background: transparent;
    border-color: transparent;
  }
  a {
    color: #000;
  }
  a:hover {
    color: var(--accent);
  }
  a.current {
    color: var(--primary);
  }
  .at-top:not(.open) a:not(:hover) {
    color: var(--light);
  }
  .brand {
    font-size: 16px;
    transition: font-size 500ms;
  }
  .at-top .brand {
    font-size: 24px;
  }
  ul {
    display: flex;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .toggle {
    display: none;
    border: 0;
    background: none;
    font-size: 24px;
    color: var(--grey);
    cursor: pointer;
  }
  .at-top:not(.open) .toggle {
    color: var(--light);
  }

  @media (max-width: 620px) {
    ul {
      gap: 8px;
      font-size: 0.85rem;
      letter-spacing: 0.5px;
    }
  }

  @media (max-width: 480px) {
    .toggle {
      display: block;
    }
    ul {
      display: none;
      position: absolute;
      inset: 45px 0 auto;
      flex-direction: column;
      gap: 0;
      padding-block: 10px;
      font-size: 1rem;
      text-align: center;
      background: #fff;
      border-bottom: 1px solid var(--grey);
    }
    .open ul {
      display: flex;
    }
    ul a {
      display: block;
      padding: 5px 0;
    }
    ul a:hover {
      color: var(--light);
      background: var(--grey);
    }
  }
</style>
