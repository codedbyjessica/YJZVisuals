---
const icons = import.meta.glob<string>('../icons/*.svg', { query: '?raw', import: 'default', eager: true });

interface Props {
  name: string;
  label?: string;
}

const { name, label } = Astro.props;
const svg = icons[`../icons/${name}.svg`];
if (!svg) throw new Error(`Missing icon: ${name}`);
---

<span class="icon" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} set:html={svg} />

<style>
  .icon {
    display: inline-block;
    width: 1em;
    height: 1em;
    line-height: 0;
  }
  .icon :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
