---
import Icon from './Icon.astro';
---

<dialog class="lightbox" aria-label="Artwork viewer">
  <button class="close" aria-label="Close"><Icon name="xmark" /></button>
  <button class="prev" aria-label="Previous">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
  </button>
  <div class="media"></div>
  <button class="next" aria-label="Next">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
  </button>
  <p class="caption"><strong></strong> <span></span></p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox')!;
  const media = dialog.querySelector('.media')!;
  const [title, caption] = dialog.querySelectorAll('.caption > *');
  let items: HTMLAnchorElement[] = [];
  let index = 0;

  function show(i: number) {
    index = i;
    const link = items[i];
    const { video } = link.dataset;
    media.replaceChildren(
      video
        ? Object.assign(document.createElement('iframe'), {
            src: `https://www.youtube-nocookie.com/embed/${video}?autoplay=1`,
            title: link.dataset.title,
            allow: 'autoplay; fullscreen; picture-in-picture',
            allowFullscreen: true,
          })
        : Object.assign(document.createElement('img'), { src: link.href, alt: link.dataset.title }),
    );
    title.textContent = link.dataset.title ?? '';
    caption.textContent = link.dataset.caption ?? '';
    dialog.classList.toggle('single', items.length < 2);
  }

  const step = (by: number) => show((index + by + items.length) % items.length);

  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>('[data-gallery] a');
    if (!link || e.metaKey || e.ctrlKey) return;
    e.preventDefault();
    items = [...link.closest('[data-gallery]')!.querySelectorAll('a')];
    show(items.indexOf(link));
    dialog.showModal();
  });

  dialog.querySelector('.close')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('.prev')!.addEventListener('click', () => step(-1));
  dialog.querySelector('.next')!.addEventListener('click', () => step(1));
  // Clicking the dark area around the artwork closes the viewer.
  dialog.addEventListener('click', (e) => (e.target === dialog || e.target === media) && dialog.close());
  // Stop videos on close (unless it was already reopened on another item).
  dialog.addEventListener('close', () => dialog.open || media.replaceChildren());
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
  });

  // Swipe left/right on touch screens.
  let touchX: number | null = null;
  dialog.addEventListener('touchstart', (e) => (touchX = e.touches[0].clientX), { passive: true });
  dialog.addEventListener('touchend', (e) => {
    if (touchX === null || items.length < 2) return;
    const dx = e.changedTouches[0].clientX - touchX;
    if (Math.abs(dx) > 50) step(dx < 0 ? 1 : -1);
    touchX = null;
  });
</script>

<style>
  .lightbox {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: max(12px, env(safe-area-inset-top)) max(12px, env(safe-area-inset-right))
      max(12px, env(safe-area-inset-bottom)) max(12px, env(safe-area-inset-left));
    border: 0;
    background: transparent;
    color: var(--light);
  }
  .lightbox[open] {
    display: grid;
    grid-template:
      'close close close' auto
      'prev media next' minmax(0, 1fr)
      'caption caption caption' auto
      / auto minmax(0, 1fr) auto;
    gap: 8px 16px;
  }
  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.9);
  }
  :global(html:has(.lightbox[open])) {
    overflow: hidden;
  }

  .media {
    grid-area: media;
    display: grid;
    place-items: center;
    min-height: 0;
    container-type: size;
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .media :global(iframe) {
    width: min(100cqw, 100cqh * 16 / 9);
    aspect-ratio: 16 / 9;
    border: 0;
  }

  .caption {
    grid-area: caption;
    align-self: center;
    margin: 0;
    max-width: 70ch;
    justify-self: center;
    text-align: center;
  }

  button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.1);
    color: #fff;
    cursor: pointer;
    font-size: 20px;
    transition: background-color 0.2s, color 0.2s;
  }
  button:hover,
  button:focus-visible {
    background: rgb(255 255 255 / 0.2);
    color: var(--accent);
  }
  button svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .close {
    grid-area: close;
    justify-self: end;
  }
  .prev,
  .next {
    align-self: center;
  }
  .prev {
    grid-area: prev;
  }
  .next {
    grid-area: next;
  }
  .single .prev,
  .single .next {
    visibility: hidden;
  }

  /* Phones: artwork uses the full width; arrows sit beside the caption. */
  @media (max-width: 700px) {
    .lightbox[open] {
      grid-template:
        'close close close' auto
        'media media media' minmax(0, 1fr)
        'prev caption next' auto
        / auto minmax(0, 1fr) auto;
      gap: 8px;
    }
    .caption {
      font-size: 0.85rem;
    }
  }
</style>
